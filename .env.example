# Backend: copy this file to .env at the repository root.
# No AI provider credentials are needed for upload and preview.
# Add a key only on your machine. Never commit .env or paste a key into chat.
OPENAI_API_KEY=
LICENCEIQ_OCR_MODEL=gpt-4.1-mini
LICENCEIQ_OCR_TIMEOUT_SECONDS=45
LICENCEIQ_READING_TIMEOUT_SECONDS=120
LICENCEIQ_OCR_MAX_IMAGE_DIMENSION=2400
LICENCEIQ_OCR_MAX_IMAGE_PIXELS=4000000
LICENCEIQ_MAX_READING_CHARACTERS=200000
LICENCEIQ_EXTRACTION_MODEL=gpt-4.1-mini
LICENCEIQ_EXTRACTION_TIMEOUT_SECONDS=60
LICENCEIQ_EXTRACTION_MAX_INPUT_CHARACTERS=200000
LICENCEIQ_EXTRACTION_MAX_OUTPUT_TOKENS=4000
LICENCEIQ_QUESTION_MODEL=gpt-4.1-mini
LICENCEIQ_QUESTION_TIMEOUT_SECONDS=60
LICENCEIQ_QUESTION_MAX_INPUT_CHARACTERS=50000
LICENCEIQ_QUESTION_MAX_OUTPUT_TOKENS=1000
LICENCEIQ_QUESTION_MAX_SELECTED_BLOCKS=8
LICENCEIQ_QUESTION_MAX_SELECTED_CHARACTERS=16000
# Temporary semantic retrieval embeds only bounded active-document blocks and one question.
LICENCEIQ_QUESTION_EMBEDDING_MODEL=text-embedding-3-small
LICENCEIQ_QUESTION_EMBEDDING_DIMENSIONS=256
LICENCEIQ_QUESTION_EMBEDDING_TIMEOUT_SECONDS=15
LICENCEIQ_QUESTION_EMBEDDING_MAX_BLOCKS=256
LICENCEIQ_QUESTION_EMBEDDING_MAX_CHARACTERS=100000
# Optional local NeMo input/output policy rails for document Q&A. They receive only the
# question or final answer, never document text or evidence. Disabled by default.
LICENCEIQ_QUESTION_GUARDRAILS_ENABLED=false
LICENCEIQ_QUESTION_GUARDRAIL_TIMEOUT_SECONDS=2
LICENCEIQ_MAX_CONCURRENT_QUESTIONS=4
LICENCEIQ_APP_NAME=LicenceIQ API
LICENCEIQ_ENVIRONMENT=development
LICENCEIQ_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# capability keeps the original local demo behavior. hybrid offers guest upload plus sign-in
# on one server. Both hybrid and jwt require all server-only JWT values below.
LICENCEIQ_AUTH_MODE=capability
# LICENCEIQ_JWT_SIGNING_KEY=
# LICENCEIQ_JWT_ISSUER=licenceiq-api
# LICENCEIQ_JWT_AUDIENCE=licenceiq-browser
# LICENCEIQ_JWT_ACCESS_TOKEN_TTL_SECONDS=900
# LICENCEIQ_BOOTSTRAP_USERNAME=
# LICENCEIQ_BOOTSTRAP_PASSWORD_HASH=
# LICENCEIQ_BOOTSTRAP_SUBJECT=

# Private uploads default to backend/.data/documents, independent of startup folder.
# Optional override: use an absolute path outside frontend/public.
# LICENCEIQ_DOCUMENT_STORAGE_DIR=C:/private/licenceiq/documents
# Use MinIO only with a configured JWT or hybrid mode. The endpoint is host[:port], without
# a URL scheme or path. Production remains JWT-only until guest abuse controls are added.
LICENCEIQ_DOCUMENT_STORAGE_BACKEND=filesystem
# LICENCEIQ_MINIO_ENDPOINT=127.0.0.1:9000
# LICENCEIQ_MINIO_ACCESS_KEY=
# LICENCEIQ_MINIO_SECRET_KEY=
# LICENCEIQ_MINIO_BUCKET=licenceiq-private
# LICENCEIQ_MINIO_PREFIX=documents
# LICENCEIQ_MINIO_SECURE=false
LICENCEIQ_MAX_UPLOAD_FILE_BYTES=10485760
LICENCEIQ_MAX_UPLOAD_REQUEST_BYTES=11534336
LICENCEIQ_DOCUMENT_RETENTION_SECONDS=86400
LICENCEIQ_MAX_PDF_PAGES=20
LICENCEIQ_MAX_IMAGE_DIMENSION=12000
LICENCEIQ_MAX_IMAGE_PIXELS=40000000

# Frontend configuration lives separately in frontend/.env.local.
# See frontend/.env.example. Never put secrets in NEXT_PUBLIC_* variables.
