{
  "schema_version": "licenceiq.fictional-golden-dataset.v0",
  "dataset_metadata": {
    "id": "fictional-licence-gold-v0",
    "title": "LicenceIQ fictional licence golden dataset v0",
    "purpose": "Local deterministic evaluation of grounded licence answers, evidence citations, retrieval, and safe abstention.",
    "scope": "These cases are a regression baseline for two supplied fictional one-page samples, not an OCR benchmark or a claim about real driving licences.",
    "source_policy": {
      "allowed_files": [
        "samples/fictional_maharashtra_licence.png",
        "samples/fictional_delhi_licence.png"
      ],
      "transcription_file": "samples/README.md",
      "page_model": "Each PNG is an independent one-page test document.",
      "document_content_trust": "untrusted_evidence_only"
    },
    "privacy": {
      "classification": "fictional_test_data_only",
      "contains_real_personal_data": false,
      "contains_runtime_document_ids": false,
      "contains_credentials_or_tokens": false,
      "contains_provider_trace_content": false,
      "external_upload_status": "reviewed_and_uploaded_2026-09-20"
    }
  },
  "case_contract": {
    "required_case_sections": [
      "input",
      "expected_output",
      "metadata"
    ],
    "allowed_statuses": [
      "ANSWERED",
      "UNAVAILABLE",
      "OUT_OF_SCOPE"
    ],
    "answer_evaluation": "When answer_equals is non-null, require exact equality; otherwise require every answer_contains value.",
    "citation_evaluation": "ANSWERED cases require at least minimum_citations citations covering every source_locator_text fragment on source_page; multi-line evidence may span multiple cited blocks. Other statuses require zero citations. Evaluator v0.2 normalizes numeric date formats, case, whitespace and punctuation for reference matching.",
    "path_evaluation": "Every ANSWERED case sets exactly one of requires_retrieval and expected_direct_lookup to true. Abstention cases set both flags to false.",
    "runtime_document_ids_forbidden": true
  },
  "cases": [
    {
      "id": "fictional-maharashtra-licence-number-direct-v0",
      "input": {
        "sample": "fictional_maharashtra_licence",
        "question": "What is the licence number?",
        "prior_questions": []
      },
      "expected_output": {
        "status": "ANSWERED",
        "answer_equals": null,
        "answer_contains": [
          "MH12 20190001234"
        ],
        "citation_required": true,
        "minimum_citations": 1,
        "source_page": 1,
        "source_locator_text": [
          "DL No: MH12 20190001234"
        ]
      },
      "metadata": {
        "task": "direct_structured_field",
        "intent": "licence_number",
        "requires_retrieval": false,
        "expected_direct_lookup": true,
        "include_in_retrieval_rank_metrics": false
      }
    },
