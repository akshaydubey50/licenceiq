# Copy to frontend/.env.local. This URL is public and contains no credentials.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Keep this aligned with LICENCEIQ_AUTH_MODE in the root .env.
# The ready-to-run local demo uses capability. Set both applications to hybrid
# only after completing the bootstrap credential setup in docs/PHASE_9_LOCAL_SETUP.md.
NEXT_PUBLIC_AUTH_MODE=capability
