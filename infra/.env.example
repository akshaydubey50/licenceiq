# Copy to infra/.env, then replace every placeholder with a unique local secret.
# This ignored file configures only the local container stack; it is not the app .env.
LICENCEIQ_POSTGRES_DATABASE=licenceiq
LICENCEIQ_POSTGRES_USER=licenceiq
LICENCEIQ_POSTGRES_PASSWORD=replace-with-a-long-random-local-password
LICENCEIQ_POSTGRES_PORT=5432

# Root credentials administer MinIO. Do not give them to the application outside
# local development; provision a limited application service account first.
LICENCEIQ_MINIO_ROOT_USER=replace-with-a-long-random-local-root-user
LICENCEIQ_MINIO_ROOT_PASSWORD=replace-with-a-long-random-local-root-password
# Docker gives LicenceIQ this separate bucket-scoped account, never the root account.
LICENCEIQ_MINIO_APP_ACCESS_KEY=licenceiq-app
LICENCEIQ_MINIO_APP_SECRET_KEY=replace-with-a-long-random-local-app-password
LICENCEIQ_MINIO_API_PORT=9000
LICENCEIQ_MINIO_CONSOLE_PORT=9001
